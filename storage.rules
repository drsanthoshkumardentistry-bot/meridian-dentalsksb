rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(clinicId) {
      return request.auth != null
          && request.auth.uid == clinicId
          && request.auth.token.email_verified == true;
    }

    // Radiographs and files: only the owning, verified account may read, write or delete.
    // New files must be a picture or a PDF and under 10 MB, so nobody can fill the
    // shared free storage with huge or unexpected files.
    match /clinics/{clinicId}/{allPaths=**} {
      allow read, delete: if isOwner(clinicId);
      allow create, update: if isOwner(clinicId)
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
