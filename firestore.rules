rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write access during initial production pilots
    // Once Firebase Auth login is active, enforce: request.auth != null;
    match /clinics/{clinicId} {
      allow read, write: if true;

      // Patient EHR Directory
      match /patients/{patientId} {
        allow read, write: if true;

        // Odontogram sub-collection
        match /ehr/{docId} {
          allow read, write: if true;
        }

        // Prescriptions sub-collection
        match /prescriptions/{rxId} {
          allow read, write: if true;
        }

        // Inter-departmental referrals sub-collection
        match /referrals/{referralId} {
          allow read, write: if true;
        }
      }

      // Consumables inventory
      match /inventory/{itemId} {
        allow read, write: if true;
      }

      // CAD-CAM lab orders
      match /labOrders/{orderId} {
        allow read, write: if true;
      }
    }
  }
}