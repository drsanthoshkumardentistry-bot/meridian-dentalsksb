rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function dentistDoc(uid) {
      return /databases/$(database)/documents/connectDentists/$(uid);
    }
    function isVerified() {
      return signedIn()
          && exists(dentistDoc(request.auth.uid))
          && get(dentistDoc(request.auth.uid)).data.status == 'verified';
    }
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/connectAdmins/$(request.auth.uid));
    }

    // A poll vote: this dentist's vote document did not exist before this write, exists after it, and picked option idx.
    function votePath(postId) { return /databases/$(database)/documents/connectPosts/$(postId)/votes/$(request.auth.uid); }
    function votedFor(postId, idx) {
      return !exists(votePath(postId)) && existsAfter(votePath(postId)) && getAfter(votePath(postId)).data.option == idx;
    }

    // ---------------- Team logins (roles) ----------------
    // clinicStaff/{email}: one invitation or membership per email. The owner creates it (status 'invited');
    // the person accepts it (status 'active') and can leave by deleting it. Access needs status active and
    // active true, so an owner cannot push someone into a clinic they did not accept.
    function myEmailKey() { return request.auth.token.email.lower(); }
    function memberDoc() { return get(/databases/$(database)/documents/clinicStaff/$(myEmailKey())); }
    function isMemberOf(clinicId) {
      return request.auth != null && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/clinicStaff/$(myEmailKey()))
          && memberDoc().data.clinicId == clinicId
          && memberDoc().data.status == 'active'
          && memberDoc().data.active == true;
    }
    function memberHasRole(clinicId, roles) { return isMemberOf(clinicId) && memberDoc().data.role in roles; }
    function isClinicOwner(clinicId) {
      return request.auth != null && request.auth.uid == clinicId && request.auth.token.email_verified == true;
    }

    match /clinicStaff/{emailKey} {
      allow get: if request.auth != null && request.auth.token.email_verified == true
                 && (myEmailKey() == emailKey || isClinicOwner(resource.data.clinicId));
      allow list: if isClinicOwner(resource.data.clinicId);
      allow create: if isClinicOwner(request.resource.data.clinicId)
                    && request.resource.data.keys().hasOnly(['email', 'clinicId', 'clinicName', 'role', 'branchIds', 'status', 'active', 'invitedBy', 'invitedAt'])
                    && request.resource.data.email == emailKey
                    && request.resource.data.role in ['manager', 'dentist', 'receptionist']
                    && request.resource.data.status == 'invited'
                    && request.resource.data.active == true;
      allow update: if (isClinicOwner(resource.data.clinicId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'branchIds', 'active'])
                        && request.resource.data.role in ['manager', 'dentist', 'receptionist'])
                    || (request.auth != null && request.auth.token.email_verified == true && myEmailKey() == emailKey
                        && resource.data.status == 'invited' && resource.data.active == true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == 'active');
      allow delete: if isClinicOwner(resource.data.clinicId)
                    || (request.auth != null && request.auth.token.email_verified == true && myEmailKey() == emailKey);
    }

    // Activity log. Team members can add entries under their own identity; only the owner and managers can
    // read them, and team members cannot change or delete an entry.
    match /clinics/{clinicId}/audit/{entryId} {
      allow create: if (isClinicOwner(clinicId) || memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']))
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['id', 'at', 'actorUid', 'actorEmail', 'actorRole', 'action', 'subject', 'detail']);
      allow read: if isClinicOwner(clinicId) || memberHasRole(clinicId, ['manager']);
      allow update, delete: if false;
    }

    // Team members reach the clinic's data by role, collection by collection (see src/roles.js).
    match /clinics/{clinicId}/patients/{d}     { allow read, write: if memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']); }
    match /clinics/{clinicId}/appointments/{d} { allow read, write: if memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']); }
    match /clinics/{clinicId}/queue/{d}        { allow read, write: if memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']); }
    match /clinics/{clinicId}/invoices/{d} {
      allow read: if memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']);
      allow write: if memberHasRole(clinicId, ['manager', 'receptionist']);
    }
    match /clinics/{clinicId}/inventory/{d} {
      allow read: if memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']);
      allow write: if memberHasRole(clinicId, ['manager']);
    }
    match /clinics/{clinicId}/employees/{d}    { allow read, write: if memberHasRole(clinicId, ['manager']); }
    match /clinics/{clinicId}/store/{d} {
      allow read: if memberHasRole(clinicId, ['manager', 'dentist', 'receptionist']);
      allow write: if memberHasRole(clinicId, ['manager']);
    }

    // Each signed-in account can only access its own clinic: clinics/{its own uid}/**
    // Accounts created with email and password must also have verified their email address.
    match /clinics/{clinicId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == clinicId
                         && request.auth.token.email_verified == true;
    }

    // Treatment estimate links for patients. The random token is the key, so a document can be
    // read only by someone holding the link. Nobody can list the collection.
    match /planShares/{token} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.clinicId
                    && request.auth.token.email_verified == true
                    && request.resource.data.decision == 'pending';

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.clinicId
                    && request.auth.token.email_verified == true;

      // The clinic can update its own link. A patient (no sign-in needed) can answer once,
      // before it expires, and can change nothing except the decision fields.
      allow update: if (request.auth != null
                        && request.auth.uid == resource.data.clinicId
                        && request.auth.token.email_verified == true)
                    || (resource.data.decision == 'pending'
                        && request.time < resource.data.expiresAt
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['decision', 'decidedAt', 'decidedName'])
                        && request.resource.data.decision in ['approved', 'declined']
                        && request.resource.data.decidedName is string
                        && request.resource.data.decidedName.size() <= 80);
    }

    // Online booking. The page document is public to read by id (never listable) and only the clinic
    // can write it. Anyone may create a request, but only a small validated shape and only while
    // the clinic has booking switched on. Only the clinic can read, answer or delete requests.
    match /bookingPages/{clinicId} {
      allow get: if true;
      allow list: if false;
      allow write: if isClinicOwner(clinicId) || memberHasRole(clinicId, ['manager']);
    }
    match /bookingRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['clinicId', 'name', 'phone', 'date', 'slot', 'service', 'note', 'status', 'createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string && request.resource.data.phone.size() == 10
                    && request.resource.data.date is string && request.resource.data.date.size() == 10
                    && request.resource.data.slot in ['Morning', 'Afternoon', 'Evening']
                    && request.resource.data['service'] is string && request.resource.data['service'].size() <= 60
                    && request.resource.data.note is string && request.resource.data.note.size() <= 300
                    && request.resource.data.clinicId is string
                    && get(/databases/$(database)/documents/bookingPages/$(request.resource.data.clinicId)).data.enabled == true;
      allow read, delete: if isClinicOwner(resource.data.clinicId) || memberHasRole(resource.data.clinicId, ['manager', 'receptionist']);
      allow update: if (isClinicOwner(resource.data.clinicId) || memberHasRole(resource.data.clinicId, ['manager', 'receptionist']))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledAt'])
                    && request.resource.data.status in ['confirmed', 'declined'];
    }

    // ---------------- MeriDent Connect: closed network of verified dentists ----------------

    // MeriDent staff. Documents here are created by hand in the Firebase console, never by the app.
    match /connectAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Private profile: registration details. Only the owner and staff can read it.
    // Nobody can verify themselves: status can only be changed by staff.
    match /connectDentists/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.listed == false
                    && !('verifiedBy' in request.resource.data);

      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && ((resource.data.status == 'pending'
                             && request.resource.data.status == 'pending'
                             && request.resource.data.listed == false
                             && !('verifiedBy' in request.resource.data))
                            || (resource.data.status == 'verified'
                                && request.resource.data.diff(resource.data).affectedKeys()
                                     .hasOnly(['timings', 'phone', 'whatsapp', 'emergencyAvailable',
                                               'acceptingReferrals', 'listed']))));
      allow delete: if false;
    }

    // Searchable listing. Only verified dentists can read it. A dentist can publish or remove
    // only their own entry, and the name, specialty and location must match the verified profile.
    match /connectDirectory/{uid} {
      allow get, list: if isVerified();
      allow create, update: if isVerified() && request.auth.uid == uid
                            && request.resource.data.geohash == get(dentistDoc(uid)).data.geohash
                            && request.resource.data.geo == get(dentistDoc(uid)).data.geo
                            && request.resource.data.fullName == get(dentistDoc(uid)).data.fullName
                            && request.resource.data.specialty == get(dentistDoc(uid)).data.specialty;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Consult requests. Only the sender and the receiving dentist can read one, and only the
    // receiver can change its status. A request can only be created together with its audit entry,
    // and case details can only be stored together with recorded consent.
    match /connectConsults/{consultId} {
      allow read: if isVerified()
                  && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);

      allow create: if isVerified()
                    && request.auth.uid == request.resource.data.fromId
                    && request.resource.data.toId != request.auth.uid
                    && exists(/databases/$(database)/documents/connectDirectory/$(request.resource.data.toId))
                    && request.resource.data.status == 'sent'
                    && request.resource.data.urgency in ['routine', 'soon', 'urgent']
                    && request.resource.data.patientRef is string
                    && request.resource.data.patientRef.size() <= 12
                    && (request.resource.data.get('caseSummary', null) == null
                        || (request.resource.data.caseSummary is string
                            && request.resource.data.caseSummary.size() <= 1500
                            && request.resource.data.get('consentVersion', null) != null
                            && request.resource.data.get('consentAt', null) != null))
                    && existsAfter(/databases/$(database)/documents/connectAudit/$('consult_' + consultId));

      allow update: if isVerified()
                    && request.auth.uid == resource.data.toId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reportBack', 'updatedAt'])
                    && ((resource.data.status == 'sent'
                         && request.resource.data.status in ['accepted', 'declined'])
                        || (resource.data.status == 'accepted'
                            && request.resource.data.status == 'completed'))
                    && (request.resource.data.get('reportBack', null) == null
                        || request.resource.data.reportBack.size() <= 1500)
                    && existsAfter(/databases/$(database)/documents/connectAudit/$('status_' + consultId + '_' + request.resource.data.status));

      allow delete: if false;
    }

    // Network feed: posts, likes, comments and follows. Only verified dentists can read or write, and the
    // author's name, qualification and specialty must match their verified profile.
    match /connectPosts/{postId} {
      allow read: if isVerified();
      allow create: if isVerified()
                    && request.auth.uid == request.resource.data.authorId
                    && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorQualification', 'authorSpecialty', 'type', 'title', 'body', 'tag', 'eventDate', 'venue', 'pollOptions', 'v0', 'v1', 'v2', 'v3', 'v4', 'likeCount', 'commentCount', 'createdAt'])
                    && request.resource.data.authorName == get(dentistDoc(request.auth.uid)).data.fullName
                    && request.resource.data.authorSpecialty == get(dentistDoc(request.auth.uid)).data.specialty
                    && request.resource.data.authorQualification == get(dentistDoc(request.auth.uid)).data.qualification
                    && request.resource.data.type in ['case', 'question', 'poll', 'update', 'event']
                    && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
                    && request.resource.data.body is string && request.resource.data.body.size() <= 2000
                    && (request.resource.data.type == 'poll' || request.resource.data.body.size() >= 10)
                    && (request.resource.data.type == 'poll'
                        ? (request.resource.data.pollOptions is list
                           && request.resource.data.pollOptions.size() >= 2 && request.resource.data.pollOptions.size() <= 5
                           && request.resource.data.v0 == 0 && request.resource.data.v1 == 0
                           && (request.resource.data.pollOptions.size() >= 3 ? request.resource.data.v2 == 0 : !('v2' in request.resource.data))
                           && (request.resource.data.pollOptions.size() >= 4 ? request.resource.data.v3 == 0 : !('v3' in request.resource.data))
                           && (request.resource.data.pollOptions.size() >= 5 ? request.resource.data.v4 == 0 : !('v4' in request.resource.data)))
                        : (!('pollOptions' in request.resource.data) && !('v0' in request.resource.data)))
                    && request.resource.data.likeCount == 0 && request.resource.data.commentCount == 0
                    && request.resource.data.createdAt == request.time;
      // Anyone verified can change only a counter, by one, and a like counter only together with the like itself.
      // The author can edit the text of their own post (never its type, author or counters), and the author of
      // a question can mark one of its comments as the answer.
      allow update: if isVerified()
                    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
                         && ((request.resource.data.likeCount == resource.data.likeCount + 1
                              && !exists(/databases/$(database)/documents/connectPosts/$(postId)/likes/$(request.auth.uid))
                              && existsAfter(/databases/$(database)/documents/connectPosts/$(postId)/likes/$(request.auth.uid)))
                             || (request.resource.data.likeCount == resource.data.likeCount - 1
                                 && exists(/databases/$(database)/documents/connectPosts/$(postId)/likes/$(request.auth.uid))
                                 && !existsAfter(/databases/$(database)/documents/connectPosts/$(postId)/likes/$(request.auth.uid)))))
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
                            && (request.resource.data.commentCount == resource.data.commentCount + 1
                                || request.resource.data.commentCount == resource.data.commentCount - 1))
                        || (request.auth.uid == resource.data.authorId
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'tag', 'eventDate', 'venue', 'editedAt'])
                            && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
                            && request.resource.data.body is string && request.resource.data.body.size() <= 2000
                            && (resource.data.type == 'poll' || request.resource.data.body.size() >= 10)
                            && request.resource.data.editedAt == request.time
                            && (!('tag' in request.resource.data) || (request.resource.data.tag is string && request.resource.data.tag.size() <= 30))
                            && (resource.data.type == 'event'
                                ? (request.resource.data.eventDate is string && request.resource.data.eventDate.size() == 10
                                   && request.resource.data.venue is string && request.resource.data.venue.size() >= 1 && request.resource.data.venue.size() <= 80)
                                : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eventDate', 'venue'])))
                        || (resource.data.type == 'poll'
                            && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v0']) && request.resource.data.v0 == resource.data.v0 + 1 && votedFor(postId, 0))
                                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v1']) && request.resource.data.v1 == resource.data.v1 + 1 && votedFor(postId, 1))
                                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v2']) && request.resource.data.v2 == resource.data.v2 + 1 && votedFor(postId, 2))
                                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v3']) && request.resource.data.v3 == resource.data.v3 + 1 && votedFor(postId, 3))
                                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v4']) && request.resource.data.v4 == resource.data.v4 + 1 && votedFor(postId, 4))))
                        || (request.auth.uid == resource.data.authorId
                            && resource.data.type == 'question'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCommentId'])
                            && request.resource.data.acceptedCommentId is string
                            && (request.resource.data.acceptedCommentId == ''
                                || exists(/databases/$(database)/documents/connectPosts/$(postId)/comments/$(request.resource.data.acceptedCommentId)))));
      allow delete: if (isVerified() && request.auth.uid == resource.data.authorId) || isAdmin();

      match /likes/{likerId} {
        allow get: if isVerified() && request.auth.uid == likerId;
        allow list: if false;
        allow create, delete: if isVerified() && request.auth.uid == likerId;
      }
      // One vote per dentist, never changed or removed. The option must exist on the poll.
      match /votes/{voterId} {
        allow get: if isVerified() && request.auth.uid == voterId;
        allow list: if false;
        allow create: if isVerified() && request.auth.uid == voterId
                      && request.resource.data.keys().hasOnly(['option', 'createdAt'])
                      && request.resource.data.option is int
                      && request.resource.data.option >= 0
                      && request.resource.data.option < get(/databases/$(database)/documents/connectPosts/$(postId)).data.pollOptions.size()
                      && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /comments/{commentId} {
        allow read: if isVerified();
        allow create: if isVerified()
                      && request.auth.uid == request.resource.data.authorId
                      && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorSpecialty', 'text', 'createdAt'])
                      && request.resource.data.authorName == get(dentistDoc(request.auth.uid)).data.fullName
                      && request.resource.data.authorSpecialty == get(dentistDoc(request.auth.uid)).data.specialty
                      && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 800
                      && request.resource.data.createdAt == request.time;
        allow delete: if (isVerified() && request.auth.uid == resource.data.authorId) || isAdmin();
      }
    }

    match /connectFollows/{followId} {
      allow read: if isVerified() && (resource.data.followerId == request.auth.uid || resource.data.followeeId == request.auth.uid);
      allow create: if isVerified()
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['followerId', 'followeeId', 'createdAt'])
                    && followId == request.auth.uid + '_' + request.resource.data.followeeId;
      allow delete: if isVerified() && resource.data.followerId == request.auth.uid;
    }

    // Saved posts. Private: only the dentist who saved a post can read, add or remove their own entries.
    match /connectSaves/{saveId} {
      allow read: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['userId', 'postId', 'createdAt'])
                    && request.resource.data.postId is string
                    && saveId == request.auth.uid + '_' + request.resource.data.postId
                    && request.resource.data.createdAt == request.time;
      allow delete: if isVerified() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Reports about a post or comment. Anyone verified can file one; only staff can read or clear them.
    match /connectReports/{reportId} {
      allow create: if isVerified()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['postId', 'commentId', 'reporterId', 'reason', 'createdAt'])
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 200;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Append-only audit log. Staff can read it; nobody can change or delete an entry.
    match /connectAudit/{entryId} {
      allow create: if isVerified() && request.resource.data.actorId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
