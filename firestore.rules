rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isClinicStaff(clinicId) {
      return isAuthenticated() && 
        (request.auth.token.clinicId == clinicId || 
         request.auth.uid in get(/databases/$(database)/documents/clinics/$(clinicId)).data.authorizedUsers);
    }

    // Clinic documents
    match /clinics/{clinicId} {
      allow read, write: if isAuthenticated();
      
      // Patient EHR records
      match /patients/{patientId} {
        allow read, write: if isAuthenticated();
        
        // Odontogram charts, clinical notes, and treatment plans
        match /charts/{chartId} {
          allow read, write: if isAuthenticated();
        }
        
        // Radiograph annotations and diagnostic records
        match /radiographs/{radId} {
          allow read, write: if isAuthenticated();
        }
      }
      
      // Chair schedules & Operatory appointments
      match /appointments/{appointmentId} {
        allow read, write: if isAuthenticated();
      }
      
      // Consumables & Clinic Inventory
      match /inventory/{itemId} {
        allow read, write: if isAuthenticated();
      }
      
      // Prosthetics & Lab Work Tracker
      match /labOrders/{orderId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}