VITE_FIREBASE_PROJECT_ID=meridian-dental
VITE_FIREBASE_STORAGE_BUCKET=meridian-dental.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=7538853494
VITE_FIREBASE_APP_ID=1:7538853494:web:e40c424cbe8d3113fa4157

